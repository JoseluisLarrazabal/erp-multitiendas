{
  "name": "erp-multitiendas-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integracion": "vitest run -c vitest.integracion.config.ts",
    "test:e2e": "playwright test",
    "db:start": "supabase start --workdir ..",
    "db:stop": "supabase stop --workdir ..",
    "db:reset": "supabase db reset --workdir ..",
    "db:test": "supabase test db --workdir ..",
    "db:types": "supabase gen types typescript --local --workdir .. > src/lib/supabase/database.types.ts.tmp && mv src/lib/supabase/database.types.ts.tmp src/lib/supabase/database.types.ts || { rm -f src/lib/supabase/database.types.ts.tmp; exit 1; }"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@serwist/turbopack": "9.5.13",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dexie": "4.4.7",
    "esbuild": "0.28.2",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serwist": "9.5.13",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "6.2.7",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
