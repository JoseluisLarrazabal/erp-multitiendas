# Supabase local: `pnpm db:start` imprime estos valores; `pnpm exec supabase status -o env --workdir ..` los repite.
# API_URL -> NEXT_PUBLIC_SUPABASE_URL, ANON_KEY -> NEXT_PUBLIC_SUPABASE_ANON_KEY. Copiar a web/.env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54420
NEXT_PUBLIC_SUPABASE_ANON_KEY=
